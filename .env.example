# ECEWS TalentScreen — environment for Docker Compose.
#   cp .env.example .env && ./scripts/init-env.sh    # fills the empty secrets
# Every value below is read by the API (apps/api/app/config.py) and/or docker-compose.yml.

# ---------------------------------------------------------------- database
POSTGRES_USER=talentscreen
POSTGRES_DB=talentscreen
POSTGRES_PASSWORD=
DATABASE_SSL=false

# ------------------------------------------------------------------- web
WEB_PORT=8080
# Origin the app is served from. Used for email links, SSO redirects and CORS.
PUBLIC_URL=http://localhost:8080
# Where the browser app lives (defaults to PUBLIC_URL). Set this only when the API
# is served from a different origin than the web app.
FRONTEND_URL=http://localhost:8080
# CORS allow-list for the API (comma-separated). The dev front end runs on :5173.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# "lax" is right when the web app proxies /api (same origin). Use "none" (implies
# Secure cookies, so HTTPS is required) only for a cross-site deployment.
COOKIE_SAMESITE=lax
API_PORT=8000

# ------------------------------------------------------------------- auth
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
LOCAL_LOGIN_ENABLED=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ------------------------------------- single sign-on (Microsoft Entra ID)
OIDC_ENABLED=false
OIDC_DISPLAY_NAME=Microsoft Entra ID
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/oidc/callback
OIDC_ROLES_CLAIM=roles
OIDC_AUTO_PROVISION=true
OIDC_DEFAULT_ROLE=viewer

# -------------------------------------------------------------- bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@ecews.local
# Leave empty to have a one-time password printed in the migrate log.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=System Administrator
ORGANISATION_NAME=Excellence Community Education Welfare Scheme (ECEWS)
# Loads the fictitious demo vacancies, CVs and role accounts on migrate.
SEED_DEMO_DATA=false
DEMO_USER_PASSWORD=

# A vacancy whose closing date has passed by more than this many days is hidden
# from vacancy listings. 0 = gone the day after it closes; 1 (default) = one
# further day of grace.
JOB_EXPIRY_GRACE_DAYS=1

# ---------------------------------------------------- personal-data keys
# 32-byte base64 key. Encrypts CV files, CV text and contact details at rest.
# Losing it makes existing CVs and contact details unreadable.
DATA_ENCRYPTION_KEY=

# ---------------------------------------------------------------- storage
# local = the "uploads" volume | s3 = MinIO (--profile s3) or any S3 | azure = Azure Blob
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/uploads
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=talentscreen-cvs
S3_FORCE_PATH_STYLE=true
AZURE_STORAGE_CONTAINER=talentscreen-cvs
AZURE_STORAGE_CONNECTION_STRING=
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_ROOT_USER=talentscreen
MINIO_ROOT_PASSWORD=
MAX_UPLOAD_MB=10
MAX_BULK_FILES=50

# --------------------------------------------- evaluation (rules + optional AI)
# The rules engine always runs. Configure a provider to add grounded LLM checks.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
AI_TIMEOUT_MS=60000
# true = the API evaluates CVs in-process (single container). Production uses the worker.
EVALUATE_INLINE=false
WORKER_CONCURRENCY=2
WORKER_REPLICAS=1

# ------------------------------------------------------------------- mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TalentScreen <no-reply@ecews.org>

# -------------------------------------------------------------- releases
REGISTRY=ecews
TAG=latest

# --------------------------------------------------------- HTTPS overlay
# Only used by docker-compose.tls.yml (Caddy).
DOMAIN=talentscreen.ecews.org
